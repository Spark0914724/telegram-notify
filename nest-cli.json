{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-microservices/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nestjs-microservices/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-microservices",
  "projects": {
    "consumer": {
      "type": "application",
      "root": "apps/consumer",
      "entryFile": "main",
      "sourceRoot": "apps/consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/consumer/tsconfig.app.json"
      }
    },
    "nestjs-microservices": {
      "type": "application",
      "root": "apps/nestjs-microservices",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-microservices/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-microservices/tsconfig.app.json"
      }
    },
    "producer": {
      "type": "application",
      "root": "apps/producer",
      "entryFile": "main",
      "sourceRoot": "apps/producer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/producer/tsconfig.app.json"
      }
    },
    "telegram-notifier": {
      "type": "application",
      "root": "apps/telegram-notifier",
      "entryFile": "main",
      "sourceRoot": "apps/telegram-notifier/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telegram-notifier/tsconfig.app.json"
      }
    }
  }
}